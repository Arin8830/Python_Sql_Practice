CREATE TABLE USERS (
    USER_ID VARCHAR(10) PRIMARY KEY,
    USER_NAME VARCHAR(50) NOT NULL,
    ROLE VARCHAR(20) NOT NULL,

    CHECK (ROLE IN ('MONITOR', 'ADMINISTER'))
);

