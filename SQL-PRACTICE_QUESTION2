CREATE TABLE CONTROLLER (
    USER_ID VARCHAR(10) NOT NULL,
    SENSOR_ID VARCHAR(10) NOT NULL,

    PRIMARY KEY (USER_ID, SENSOR_ID),

    FOREIGN KEY (USER_ID)
        REFERENCES USERS(USER_ID),

    FOREIGN KEY (SENSOR_ID)
        REFERENCES SENSORS(SENSOR_ID)
);

